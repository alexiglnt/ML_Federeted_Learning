     root * /home/alexi/sites/NoteFinder/dist
    file_server
    try_files {path} /index.html
}

notefinder.apk.alexigallonet.com {
    root * /home/alexi/sites/NoteFinderAPK
    file_server
}

notefinder.api.alexigallonet.com {

    @cors_origin_localhost header Origin http://localhost:5173
    @cors_origin_production header Origin https://notefinder.alexigallonet.com
    @cors_enabled {
        expression {header.Origin} == "http://localhost:5173" || {header.Origin} == "https://notefinder.alexigallonet.com"
    }

    
    header @cors_origin_localhost {
        Access-Control-Allow-Origin "http://localhost:5173"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "*"
        Access-Control-Allow-Credentials "true"
        Access-Control-Max-Age "3600"
        defer
    }

    header @cors_origin_production {
        Access-Control-Allow-Origin "https://notefinder.alexigallonet.com"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "*"
        Access-Control-Allow-Credentials "true"
        Access-Control-Max-Age "3600"
        defer
    }
    
    
    @options method OPTIONS
    respond @options 204
    
    
    reverse_proxy localhost:3457
}
