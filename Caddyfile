# epreuve-pratique-ci-cd.alexigallonet.com {
epreuve-tp-finale-ci-cd.alexigallonet.com {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy 127.0.0.1:5000
  }

  handle {
    reverse_proxy 127.0.0.1:8081
  }

  log {
    output file /var/log/caddy/epci.log
  }
}

