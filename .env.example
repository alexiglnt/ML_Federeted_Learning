# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Every value here has a working default for local development, so an empty
# .env — or no .env at all — still gives a running site via
# `docker compose up --build`. The one exception is MLFL_SECRET_KEY: startup
# refuses to run with its default when MLFL_ENVIRONMENT is not "development".

# "development" relaxes a few guards. Anything else is treated as a real
# deployment: the session cookie becomes Secure (HTTPS only) and the secret key
# check below is enforced.
MLFL_ENVIRONMENT=development

MLFL_DATABASE_URL=postgresql+psycopg://mlfl:mlfl@db:5432/mlfl

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everybody out, which is the intended emergency lever.
MLFL_SECRET_KEY=dev-only-insecure-secret-change-me

# Load the variable registry and a demo project into an empty database.
# Turn this off on a real deployment: it creates a demo account with a
# published password (demo@example.com / see api/seed.py).
MLFL_SEED_ON_START=1

# Only read by docker-compose.prod.yml, to set the Postgres password and
# build MLFL_DATABASE_URL consistently (see that file). Not used by
# docker-compose.yml, which hardcodes a throwaway dev password instead.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
