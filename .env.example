# Copiez ce fichier en « .env » (à côté de ce fichier, PAS dans web/) et
# remplissez les deux valeurs. Ne le partagez jamais et ne le committez
# jamais : il est ignoré par git (voir .gitignore).
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# Puis éditez .env avec un simple éditeur de texte.

# Donnée à tous les collègues autorisés à contribuer au modèle (POST /api/contribute).
# Choisissez une phrase quelconque, envoyez-la par mail à vos collègues.
DEAM_FL_API_KEY=

# Réservée à vous seul : elle donne accès à la file d'attente des contributions
# reçues (GET /api/queue), avant qu'elles ne soient intégrées au modèle publié.
# Ne la partagez avec personne, pas même les contributeurs.
DEAM_FL_ADMIN_KEY=
