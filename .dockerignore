# Keep the build context small and, more importantly, keep secrets and other
# people's data out of the image.
.env
var/
api/var/
legacy/

.git/
.venv/
.venv-tools/
__pycache__/
*.py[cod]

node_modules/
web/node_modules/
web/dist/

# Documentation is not needed at runtime, but tests/ is: the invariant checks
# are meant to be runnable against a deployed container.
*.md
!tests/*.md

.vscode/
.idea/
