# Remplacer par le vrai nom de domaine du site (doit déjà pointer vers
# l'adresse IP de ce serveur avant de démarrer). Caddy obtient et renouvelle
# seul le certificat HTTPS — rien d'autre à configurer, pas de certbot.
votre-domaine.exemple.com {
    reverse_proxy app:8000
}

