# Secrets. .env.example is committed; .env never is.
.env

# Uploaded files, model artefacts, anything a contributor entrusted to the
# server. Never in the repository.
var/
api/var/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-tools/
*.egg-info/

# Node
node_modules/
web/dist/
# Incremental build cache written by `tsc -b`; machine-specific and noisy.
*.tsbuildinfo

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# The pre-rebuild site's private store: published models were public, but
# queued contributions and pooled sums were not.
legacy/server/store/
